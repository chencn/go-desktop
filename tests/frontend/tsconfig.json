{
  "extends": "../../frontend/tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../frontend/node_modules/@types"
    ],
    "paths": {
      "@/*": [
        "../../frontend/src/*"
      ],
      "vitest": [
        "../../frontend/node_modules/vitest/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "*.test.ts",
    "../../frontend/src/**/*.ts",
    "../../frontend/src/**/*.d.ts",
    "../../frontend/bindings/**/*.ts"
  ],
  "exclude": [
    "../../frontend/src/components/ui/**/*.vue"
  ]
}